{
  "name": "rdx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm --filter @lexibase/rdx-types build && turbo run check-types",
    "check": "pnpm lint && pnpm check-types && pnpm docs:check && pnpm build && pnpm test",
    "docs:check": "pnpm --filter web docs:check",
    "test": "turbo run test && node --test scripts/tests/*.test.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "test:deploy": "node scripts/create-deploy-test.mjs",
    "release:note": "changeset",
    "release:plan": "node scripts/prepare-release.mjs --dry-run",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:pack": "node scripts/publish-release.mjs pack",
    "prepare": "husky",
    "format:check": "node scripts/check-staged-format.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
