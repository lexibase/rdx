{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm run docs:prepare && next dev",
    "build": "pnpm run docs:prepare && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/documentation*.test.mjs",
    "test:runtime": "node --test tests/version-browser.integration.mjs",
    "docs:prepare": "tsx scripts/project.ts prepare",
    "docs:version": "tsx scripts/project.ts version"
  },
  "dependencies": {
    "@lexibase/rdx-core": "workspace:*",
    "@lexibase/rdx-versioning": "workspace:*",
    "@lexibase/rdx-ui": "workspace:*",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@lexibase/rdx-types": "workspace:*",
    "@rdx/eslint-config": "workspace:^",
    "@rdx/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
