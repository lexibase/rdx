{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run prepare && next dev --port 3000",
    "build": "npm run prepare && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "prepare": "npm exec rdx-generate-versions"
  },
  "dependencies": {
    "@rdx/core": "workspace:*",
    "@rdx/rdx-versioning": "workspace:*",
    "@lexibase/rdx-ui": "workspace:*",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.13",
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@rdx/eslint-config": "workspace:^",
    "@rdx/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  }
}
