{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "web#lint": {
      "dependsOn": ["^lint", "^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "web#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/production-server.mjs"
      ]
    },
    "@lexibase/rdx-next#test": {
      "dependsOn": ["build", "@lexibase/rdx-versioning#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/components/Page/version-banner.tsx"
      ]
    },
    "test:runtime": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "RDX_PLAYWRIGHT_MODULE",
        "RDX_BROWSER_EXECUTABLE",
        "RDX_THEME_SCREENSHOTS"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "web#check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web#dev": {
      "dependsOn": ["^build"],
      "with": [
        "@lexibase/rdx-core#dev",
        "@lexibase/rdx-types#dev",
        "@lexibase/rdx-versioning#dev"
      ],
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    },
    "@lexibase/rdx-core#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@lexibase/rdx-next#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@lexibase/rdx-versioning#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@lexibase/rdx-types#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
