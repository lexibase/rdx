{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@lexibase/rdx-next#test": {
      "dependsOn": ["build", "@lexibase/rdx-versioning#build"]
    },
    "test:runtime": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "RDX_PLAYWRIGHT_MODULE",
        "RDX_BROWSER_EXECUTABLE",
        "RDX_THEME_SCREENSHOTS"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
