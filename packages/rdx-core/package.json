{
  "name": "@lexibase/rdx-core",
  "version": "2.1.0",
  "description": "Content indexing and document utilities for RDX documentation projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "import": "./dist/mdx/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup src/index.ts src/config/index.ts src/mdx/index.ts src/search/index.ts src/check/index.ts --format esm --dts --watch --external @lexibase/rdx-types --external gray-matter",
    "build": "tsup src/index.ts src/config/index.ts src/mdx/index.ts src/search/index.ts src/check/index.ts --format esm --dts --clean --external @lexibase/rdx-types --external gray-matter",
    "check-types": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexibase/rdx.git",
    "directory": "packages/rdx-core"
  },
  "bugs": {
    "url": "https://github.com/lexibase/rdx/issues"
  },
  "homepage": "https://github.com/lexibase/rdx#readme",
  "dependencies": {
    "@lexibase/rdx-types": "workspace:*",
    "@shikijs/rehype": "^4.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@rdx/eslint-config": "workspace:*",
    "@rdx/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
