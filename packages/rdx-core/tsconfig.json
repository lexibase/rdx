{
  "extends": "@rdx/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "paths": {
      "@/*": ["./*"],
      "@lexibase/rdx-core/*": ["./src/*"],
      "@lexibase/rdx-types": ["../rdx-types/src/index.d.ts"],
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
