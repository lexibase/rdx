{
  "name": "@lexibase/rdx",
  "version": "1.1.0",
  "description": "The RDX documentation framework, with compatible runtime and UI packages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "bin": {
    "rdx": "./bin/rdx.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./postcss.config": "./dist/postcss.config.js",
    "./styles.css": {
      "types": "./dist/styles.d.css.ts",
      "default": "./dist/styles.css"
    },
    "./ui/globals.css": {
      "types": "./dist/ui/globals.d.css.ts",
      "default": "./dist/ui/globals.css"
    },
    "./ui/components/*": {
      "types": "./dist/ui/components/*.d.ts",
      "import": "./dist/ui/components/*.js"
    },
    "./ui/lib/*": {
      "types": "./dist/ui/lib/*.d.ts",
      "import": "./dist/ui/lib/*.js"
    },
    "./ui/providers/*": {
      "types": "./dist/ui/providers/*.d.ts",
      "import": "./dist/ui/providers/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lexibase/rdx-next": "workspace:*",
    "@lexibase/rdx-ui": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rdx/eslint-config": "workspace:*",
    "eslint": "^9.39.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexibase/rdx.git",
    "directory": "packages/rdx"
  }
}
