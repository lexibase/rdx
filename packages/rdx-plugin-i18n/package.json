{
  "name": "@lexibase/rdx-i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Optional multilingual documentation for RDX.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @lexibase/rdx-types --external @lexibase/rdx-core",
    "check-types": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "dependencies": {
    "@lexibase/rdx-core": "workspace:*",
    "@lexibase/rdx-types": "workspace:*"
  },
  "devDependencies": {
    "@lexibase/rdx-versioning": "workspace:*",
    "@types/node": "^22.15.3"
  }
}
