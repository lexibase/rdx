{
  "name": "@lexibase/rdx-next",
  "version": "1.0.0-beta.9",
  "description": "The Next.js runtime for RDX documentation projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "bin": {
    "rdx": "./bin/rdx.mjs"
  },
  "exports": {
    "./postcss.config": "./postcss.config.mjs",
    "./styles.css": {
      "types": "./src/runtime/styles.d.css.ts",
      "default": "./src/runtime/styles.css"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "postcss.config.mjs",
    "src/runtime/styles.css",
    "src/runtime/styles.d.css.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/runtime/index.tsx --format esm --dts --clean --external @lexibase/rdx-core --external @lexibase/rdx-types --external next --external react --external react-dom --external next-mdx-remote",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "node --test tests/runtime.integration.mjs"
  },
  "dependencies": {
    "@lexibase/rdx-core": "workspace:*",
    "@lexibase/rdx-types": "workspace:*",
    "@lexibase/rdx-ui": "workspace:*",
    "cross-spawn": "^7.0.6",
    "jiti": "^2.6.1",
    "next-mdx-remote": "^6.0.0",
    "remark-gfm": "^4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexibase/rdx.git",
    "directory": "packages/rdx-next"
  },
  "bugs": {
    "url": "https://github.com/lexibase/rdx/issues"
  },
  "homepage": "https://github.com/lexibase/rdx#readme",
  "devDependencies": {
    "@rdx/eslint-config": "workspace:*",
    "@rdx/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
