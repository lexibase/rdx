      "default": "./src/styles/globals.css"
    },
    "./postcss.config": "./postcss.config.mjs",
    "./postcss-plugin": "./postcss-plugin.cjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
