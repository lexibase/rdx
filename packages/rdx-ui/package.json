    "next-themes": "^0.4.6",
    "postcss": "^8.5.31",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rdx/eslint-config": "workspace:*",
    "@rdx/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
